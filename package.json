{
  "name": "proteus",
  "version": "0.2.2",
  "buildRevision": "source",
  "private": true,
  "description": "A local control room for scheduled AI work and resumable conversations.",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "cli": "node src/cli.js",
    "relay": "node relay/server.js",
    "relay:local": "node scripts/local-relay.mjs",
    "test:remote-ui": "node test/remote-ui.mjs",
    "ios:generate": "xcodegen generate --spec ios/project.yml",
    "markdown:build": "node scripts/build-markdown.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "ios:doctor": "node scripts/apple-build.mjs doctor",
    "ios:build": "node scripts/apple-build.mjs build",
    "ios:test": "node scripts/apple-build.mjs test",
    "terminal:build": "node scripts/build-terminal.mjs",
    "postinstall": "node scripts/prepare-pty.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.16",
    "cron-parser": "5.10.1",
    "ghostty-web": "0.4.0",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "mysql2": "3.24.5",
    "node-pty": "1.1.0",
    "playwright": "1.58.2",
    "qrcode": "1.5.4",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.0",
    "electron": "44.5.1",
    "esbuild": "0.28.2"
  }
}
