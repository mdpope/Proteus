{
  "name": "proteus",
  "version": "0.2.46",
  "buildRevision": "source",
  "private": true,
  "description": "A local control room for scheduled AI work and resumable conversations.",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron .",
    "desktop:preview": "node scripts/desktop-preview.mjs",
    "desktop:demo": "node scripts/desktop-demo.mjs",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "cli": "node src/cli.js",
    "relay": "node relay/server.js",
    "relay:local": "node scripts/local-relay.mjs",
    "test:remote-ui": "node test/remote-ui.mjs",
    "ios:generate": "xcodegen generate --spec ios/project.yml",
    "markdown:build": "node scripts/build-markdown.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "ios:doctor": "node scripts/apple-build.mjs doctor",
    "ios:preview:phone": "node scripts/iphone-design-preview.mjs",
    "ios:build": "node scripts/apple-build.mjs build",
    "ios:test": "node scripts/apple-build.mjs test",
    "terminal:build": "node scripts/build-terminal.mjs",
    "postinstall": "node scripts/prepare-pty.mjs && node scripts/prepare-extensions.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "test:linux": "node test/linux-current.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "scratch:editor:build": "node scripts/build-scratch-editor.mjs",
    "code:editor:build": "node scripts/build-code-editor.mjs"
  },
  "dependencies": {
    "@azure-devops/mcp": "2.11.0",
    "@azure/msal-node": "7.2.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@ghostery/adblocker-electron": "2.20.1",
    "@github/copilot-sdk": "1.0.28",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.83",
    "ajv": "8.20.0",
    "chrome-devtools-mcp": "1.10.1",
    "codemirror": "6.0.2",
    "cron-parser": "5.10.1",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0",
    "esbuild": "^0.28.2",
    "ghostty-web": "0.4.0",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "mysql2": "3.24.5",
    "node-pty": "1.1.0",
    "playwright": "1.64.0",
    "qrcode": "1.5.4",
    "sql.js": "1.13.0",
    "tar": "7.5.22",
    "tldts-experimental": "7.4.18",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.0",
    "electron": "44.11.5",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "electron-chrome-web-store": {
      "adm-zip": "0.6.1"
    },
    "@azure-devops/mcp": {
      "@azure/msal-node": "7.2.0"
    },
    "@github/copilot-sdk": {
      "zod": "4.6.7"
    },
    "@modelcontextprotocol/sdk": {
      "zod": "4.6.7",
      ".": "$@modelcontextprotocol/sdk"
    },
    "@electron/get": {
      "undici": "7.30.1"
    }
  },
  "updatesProtocol": 1,
  "dataCompatibility": 1,
  "releaseDate": "2026-11-17",
  "releaseName": "Nov 17"
}
